{
  "name": "@linwood/butterfly-nextcloud",
  "version": "0.1.0",
  "private": true,
  "description": "Edit Butterfly documents in Nextcloud",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "pnpm clean && vite build",
    "check": "pnpm run lint && pnpm run stylelint && pnpm run typecheck && pnpm run build",
    "clean": "node scripts/clean.mjs",
    "dev": "vite --mode development build",
    "lint": "eslint src",
    "stylelint": "stylelint src/**/*.vue src/**/*.scss src/**/*.css",
    "typecheck": "vue-tsc --noEmit",
    "watch": "vite --mode development build --watch"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@linwood/butterfly-integration-shared": "workspace:*",
    "@nextcloud/axios": "^2.6.0",
    "@nextcloud/files": "^4.0.0",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vue": "^9.9.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/stylelint-config": "^3.2.2",
    "@nextcloud/vite-config": "^2.5.4",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-use-logical": "^2.1.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.9"
  }
}
